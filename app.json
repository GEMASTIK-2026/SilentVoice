{
  "expo": {
    "name": "SilentVoice",
    "slug": "SilentVoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/LogoSV.webp",
    "scheme": "silentvoice",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/LogoSV.webp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/LogoSV.webp",
        "backgroundImage": "./src/assets/images/LogoSV.webp",
        "monochromeImage": "./src/assets/images/LogoSV.webp"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/LogoSV.webp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/LogoSV.webp",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SilentVoice memerlukan akses kamera untuk mengkonversi bahasa isyarat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
