{
  "expo": {
    "name": "SilentVoice",
    "slug": "SilentVoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/LogoSV.png",
    "scheme": "silentvoice",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/LogoSV.png",
      "infoPlist": {
        "NSCameraUsageDescription": "SilentVoice memerlukan akses kamera untuk konversi bahasa isyarat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/LogoSV.png",
        "backgroundImage": "./src/assets/images/LogoSV.png",
        "monochromeImage": "./src/assets/images/LogoSV.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.SilentVoice"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/LogoSV.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withLipPipeline",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/LogoSV.png",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SilentVoice memerlukan akses kamera untuk mengkonversi bahasa isyarat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": false
  }
}
